rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active") ||
          (request.auth.token.email == "thienthanhnguyen0860@gmail.com")
        );
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    // Self-profile read/create/update with strict whitelist; Admin full access
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && request.resource.data.role == "user" && request.resource.data.status == "active") || isAdmin();
      allow update: if (
        isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'photoURL', 'favorites', 'updatedAt', 'lastLoginAt'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Properties collection
    // Public read; Admin exclusive write
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Projects collection
    // Public read; Admin exclusive write
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories collection
    // Public read; Admin exclusive write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Agents collection
    // Public read; Admin exclusive write
    match /agents/{agentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Inquiries collection
    // Public/User create with strict status="new"; User read own; Admin read/update/delete
    match /inquiries/{inquiryId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (
        request.resource.data.status == "new" &&
        (!('assignedAgentId' in request.resource.data) || request.resource.data.assignedAgentId == null) &&
        (!('assignedTo' in request.resource.data) || request.resource.data.assignedTo == null) &&
        (!('adminNote' in request.resource.data) || request.resource.data.adminNote == '') &&
        (!('notes' in request.resource.data) || request.resource.data.notes == '')
      ) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Reservations collection
    // User create with strict status="pending" and unapproved; User read own; Admin full control
    match /reservations/{reservationId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (
        isAuthenticated() &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.status == "pending" &&
        request.resource.data.paymentMethod == "bank_transfer" &&
        request.resource.data.approvedAt == null &&
        request.resource.data.approvedBy == null &&
        request.resource.data.cancelledAt == null
      ) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Payment Public Settings (Bank accounts, QR, instructions for checkout)
    match /paymentPublicSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payment Private Settings (API keys, webhooks, merchant credentials)
    match /paymentPrivateSettings/{docId} {
      allow read, write: if isAdmin();
    }

    // Payment Settings (Legacy/Unified)
    match /paymentSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Settings collection
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Logs collection (Immutable audit logs)
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
